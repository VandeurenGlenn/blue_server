{
	"name": "@blueserver/env",
	"version": "1.0.0",
	"type": "module",
	"module": "./lib/index.js",
	"main": "./lib/index.js",
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"tsconfig.json",
				".env",
				"src"
			],
			"output": [
				"lib"
			]
		}
	},
	"exports": {
		".": {
			"default": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"dependencies": {
		"dotenv": "^16.4.5"
	}
}
