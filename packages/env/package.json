{
	"name": "@blueserver/env",
	"version": "1.0.0",
	"type": "module",
	"module": "./lib/index.js",
	"main": "./lib/index.js",
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"command": "tsc --pretty",
		"clean": "if-file-deleted",
		"files": [
			"tsconfig.json",
			"src"
		],
		"output": [
			"lib"
		]
	},
	"exports": {
		".": {
			"default": "./lib/index.js",
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	}
}
