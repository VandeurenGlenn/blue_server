{
	"name": "@blueserver/server",
	"description": "blue server: API server",
	"type": "module",
	"exports": {
		"./constants": {
			"types": "./lib/constants.d.ts",
			"import": "./lib/constants.js"
		}
	},
	"scripts": {
		"build": "wireit",
		"serve": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"dependencies": [
				"../env:build",
				"../api:build"
			],
			"files": [
				"tsconfig.json",
				"src"
			],
			"output": [
				"lib"
			]
		},
		"serve": {
			"#comment": "restart the server when the build files changed",
			"command": "node ./lib/index.js",
			"service": true,
			"files": [
				".env"
			],
			"dependencies": [
				"build"
			]
		}
	},
	"devDependencies": {
		"@blueserver/types": "*",
		"@blueserver/api": "*",
		"@blueserver/env": "*",
		"@types/cron": "^2.0.1",
		"@types/koa": "^2.15.0",
		"@types/koa-cors": "^0.0.6",
		"@types/koa-router": "^7.4.8",
		"@types/node": "^22.5.1",
		"@types/node-fetch": "^2.6.11",
		"dotenv": "^16.4.5",
		"node-fetch": "^3.3.2",
		"cron": "^3.1.7"
	}
}
