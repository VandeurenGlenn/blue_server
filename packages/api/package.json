{
	"name": "@blueserver/api",
	"description": "> server/client api provider(s)",
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/api/api.js",
			"types": "./lib/api/api.d.ts"
		},
		"./constants": {
			"types": "./lib/constants.d.ts",
			"import": "./lib/constants.js"
		},
		"./cache": {
			"types": "./lib/cache.d.ts",
			"import": "./lib/cache.js"
		},
		"./client/http": {
			"import": "./lib/client/http/index.js",
			"types": "./lib/client/http/index.d.ts"
		},
		"./client/ws": {
			"import": "./lib/client/ws/index.js",
			"types": "./lib/client/ws/index.d.ts"
		},
		"./pubsub": {
			"import": "./lib/pubsub.js",
			"types": "./lib/pubsub.d.ts"
		}
	},
	"scripts": {
		"build": "wireit",
		"ncu": "ncu -u --install always"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"dependencies": [
				"../env:build"
			],
			"files": [
				"tsconfig.json",
				"src"
			],
			"output": [
				"lib"
			]
		}
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@blueserver/api": "*",
		"@blueserver/env": "*",
		"@koa/cors": "^5.0.0",
		"@koa/router": "^13.0.0",
		"node-fetch": "^3.3.2",
		"koa": "^2.15.3",
		"socket-request-client": "^2.0.9",
		"socket-request-server": "^1.6.9"
	},
	"devDependencies": {
		"@types/koa__cors": "^5.0.0",
		"@types/koa__router": "^12.0.4",
		"@types/node-fetch": "^2.6.11"
	}
}
